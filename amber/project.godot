; Engine configuration file.
; Amber — asymmetric horror survival prototype.

config_version=5

[application]

config/name="Amber"
config/description="Asymmetric horror survival prototype: five survivor duos build radios and escape by helicopter while three killers hunt them. Caught survivors join the hunt."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://icon.svg"

[autoload]

Game="*res://scripts/core/game.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

common/physics_ticks_per_second=30

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
limits/opengl/max_renderable_lights=64
limits/opengl/max_lights_per_object=12
anti_aliasing/quality/msaa_3d=1
